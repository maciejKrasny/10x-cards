---
import Layout from "@/layouts/Layout.astro";
import StudySessionPage from "@/components/study/StudySessionPage";

const deckId = Astro.params.deckId ?? "";
---

<Layout title="Study">
  <div class="bg-cosmic flex min-h-screen flex-col items-center p-4">
    <div class="mt-10 w-full max-w-2xl rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <StudySessionPage deckId={deckId} client:load />
    </div>
  </div>
</Layout>
