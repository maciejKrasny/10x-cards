---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import PasteToGenerate from "@/components/cards/PasteToGenerate";
---

<Layout title="Generate">
  <div class="bg-cosmic flex min-h-screen flex-col items-center p-4">
    <div class="mt-4 w-full max-w-3xl">
      <Topbar />
    </div>
    <div class="mt-6 w-full max-w-3xl rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <h1 class="mb-6 text-2xl font-semibold text-white">Generate cards from text</h1>
      <PasteToGenerate client:load />
    </div>
  </div>
</Layout>
