---
import Layout from "@/layouts/Layout.astro";
import DeckListPage from "@/components/decks/DeckListPage";
---

<Layout title="Decks">
  <div class="bg-cosmic flex min-h-screen flex-col items-center p-4">
    <div class="mt-10 w-full max-w-3xl rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <a href="/dashboard" class="mb-4 inline-block text-sm text-blue-200/80 hover:text-white">← Back to dashboard</a>
      <DeckListPage client:load />
    </div>
  </div>
</Layout>
