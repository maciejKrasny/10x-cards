---
import Layout from "@/layouts/Layout.astro";
import DeckDetailPage from "@/components/cards/DeckDetailPage";

const id = Astro.params.id ?? "";
---

<Layout title="Deck">
  <div class="bg-cosmic flex min-h-screen flex-col items-center p-4">
    <div class="mt-10 w-full max-w-3xl rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <DeckDetailPage deckId={id} client:load />
    </div>
  </div>
</Layout>
